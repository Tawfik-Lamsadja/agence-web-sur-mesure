{
  "platform": { "apiRuntime": "node:20" },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/css/*", "/js/*", "/admin*", "/qr*", "*.{svg,ico,png,jpg,jpeg,webp,avif,mp4,webm}"]
  },
  "mimeTypes": {
    ".svg": "image/svg+xml",
    ".mp4": "video/mp4",
    ".webm": "video/webm",
    ".webp": "image/webp",
    ".avif": "image/avif",
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/api/*", "headers": { "Cache-Control": "no-store" } },
    { "route": "/admin", "rewrite": "/admin.html" },
    { "route": "/qr", "rewrite": "/qr.html" },
    { "route": "/admin*", "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow" } },
    { "route": "/qr*", "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=2592000" } },
    { "route": "/css/*",    "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/js/*",     "headers": { "Cache-Control": "public, max-age=604800" } }
  ]
}
